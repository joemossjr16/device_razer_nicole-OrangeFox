diff --git a/data.cpp b/data.cpp
index b9e91b6a..d5a7f067 100755
--- a/data.cpp
+++ b/data.cpp
@@ -1221,11 +1221,7 @@ void DataManager::SetDefaultValues()
   mPersist.SetValue(FOX_PERFORMANCE_CHECK, "0");
   mPersist.SetValue(FOX_BALANCE_CHECK, "1");
 
-#ifdef OF_USE_LOCKSCREEN_BUTTON
   mPersist.SetValue("lock_btn", "1");
-#else
-  mPersist.SetValue("lock_btn", "0");
-#endif
 
   mConst.SetValue(FOX_SURVIVAL_FOLDER_VAR, FOX_SURVIVAL_FOLDER);
   mConst.SetValue(FOX_SURVIVAL_BACKUP_NAME, FOX_SURVIVAL_BACKUP);
@@ -1319,7 +1315,7 @@ void DataManager::SetDefaultValues()
   mConst.SetValue("tw_screen_timeout_secs", "0");
   mConst.SetValue("tw_no_screen_timeout", "1");
 #else
-  mPersist.SetValue("tw_screen_timeout_secs", "60");
+  mPersist.SetValue("tw_screen_timeout_secs", "0");
   mPersist.SetValue("tw_no_screen_timeout", "0");
 #endif
 
diff --git a/gui/blanktimer.cpp b/gui/blanktimer.cpp
index 1c946ea7..9d2a5ed7 100755
--- a/gui/blanktimer.cpp
+++ b/gui/blanktimer.cpp
@@ -56,6 +56,7 @@ void blanktimer::setTimer(void) {
 }
 
 void blanktimer::checkForTimeout() {
+	return;
 #ifndef TW_NO_SCREEN_TIMEOUT
 	pthread_mutex_lock(&mutex);
 	timespec curTime, diff;
diff --git a/gui/gesture.cpp b/gui/gesture.cpp
index b2a2f390..0f483e09 100755
--- a/gui/gesture.cpp
+++ b/gui/gesture.cpp
@@ -63,7 +63,7 @@ GUIGesture::GUIGesture(xml_node<>* node)
 
 	xml_node<>* child = FindNode(node, "settings");
 	mMode = LoadAttrInt(child, "side", mMode);
-	mSensetivity = LoadAttrIntScaleX(child, "sense", mSensetivity);
+	mSensetivity = (mMode == 0 || mMode == 3) ? LoadAttrIntScaleY(child, "sense", mSensetivity) : LoadAttrIntScaleX(child, "sense", mSensetivity);
 
 	int x = 0, y = 0, w = 0, h = 0;
 	if (hasFill)
@@ -124,10 +124,10 @@ int GUIGesture::NotifyTouch(TOUCH_STATE state, int x, int y)
 		vibrateLock = false; //Execute gesture action only one time
 
 	if ((
-		(mMode == 0 && y < mRenderY - mSensetivity && y > center) ||
+		(mMode == 0 && y < mRenderY - mSensetivity) ||
 		(mMode == 1 && x < mRenderX - mSensetivity) ||
 		(mMode == 2 && x > mRenderX + mSensetivity + mRenderW) ||
-		(mMode == 3 && y > mRenderY + mSensetivity + mRenderH && y < center)
+		(mMode == 3 && y > mRenderY + mSensetivity + mRenderH)
 		) && !vibrateLock)  {
 		#ifndef TW_NO_HAPTICS
 			DataManager::Vibrate("tw_button_vibrate");
diff --git a/gui/scrolllist.cpp b/gui/scrolllist.cpp
index 2b069413..54b0792c 100755
--- a/gui/scrolllist.cpp
+++ b/gui/scrolllist.cpp
@@ -470,7 +470,7 @@ void GUIScrollList::RenderStdItem(int yPos, bool selected, ImageResource* icon,
 			int arrowH = groupArrow->GetHeight();
 			int arrowW = groupArrow->GetWidth();
 			int arrowY = yPos + (iconAndTextH - arrowH) / 2;
-			int arrowX = mRenderW - groupOffset - 75;
+			int arrowX = mRenderX + mRenderW - groupOffset - 75;
 			gr_blit(groupArrow->GetResource(), 0, 0, arrowW, arrowH, arrowX, arrowY);
 		}
 	} else if (isHighlight) {
