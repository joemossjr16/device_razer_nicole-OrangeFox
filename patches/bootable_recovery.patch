diff --git a/minuitwrp/events.cpp b/minuitwrp/events.cpp
index e497df6..c7f4c52 100644
--- a/minuitwrp/events.cpp
+++ b/minuitwrp/events.cpp
@@ -53,6 +53,48 @@ static std::atomic_int vib_on_count = 0;
 #include "twcommon.h"
 
 #include "minuitwrp/minui.h"
+#include <cutils/properties.h>
+
+extern unsigned int gr_rotation;
+
+static bool touch_should_swap_xy() {
+#ifdef RECOVERY_TOUCHSCREEN_SWAP_XY
+    int default_swap = 1;
+#else
+    int default_swap = (gr_rotation == 90 || gr_rotation == 270) ? 1 : 0;
+#endif
+    char prop[PROPERTY_VALUE_MAX];
+    char def_str[4];
+    snprintf(def_str, sizeof(def_str), "%d", default_swap);
+    property_get("persist.twrp.touch_swap_xy", prop, def_str);
+    return atoi(prop) != 0;
+}
+
+static bool touch_should_flip_x() {
+#ifdef RECOVERY_TOUCHSCREEN_FLIP_X
+    int default_flip = 1;
+#else
+    int default_flip = (gr_rotation == 90 || gr_rotation == 180) ? 1 : 0;
+#endif
+    char prop[PROPERTY_VALUE_MAX];
+    char def_str[4];
+    snprintf(def_str, sizeof(def_str), "%d", default_flip);
+    property_get("persist.twrp.touch_flip_x", prop, def_str);
+    return atoi(prop) != 0;
+}
+
+static bool touch_should_flip_y() {
+#ifdef RECOVERY_TOUCHSCREEN_FLIP_Y
+    int default_flip = 1;
+#else
+    int default_flip = (gr_rotation == 270 || gr_rotation == 180) ? 1 : 0;
+#endif
+    char prop[PROPERTY_VALUE_MAX];
+    char def_str[4];
+    snprintf(def_str, sizeof(def_str), "%d", default_flip);
+    property_get("persist.twrp.touch_flip_y", prop, def_str);
+    return atoi(prop) != 0;
+}
 
 //#define _EVENT_LOGGING
 
@@ -448,14 +490,12 @@ static int vk_tp_to_screen(struct position *p, int *x, int *y)
     printf("EV: p->x=%d  x-range=%d,%d  fb-width=%d\n", p->x, p->xi.minimum, p->xi.maximum, gr_fb_width());
 #endif
 
-#ifndef RECOVERY_TOUCHSCREEN_SWAP_XY
     int fb_width = gr_fb_width();
     int fb_height = gr_fb_height();
-#else
-    // We need to swap the scaling sizes, too
-    int fb_width = gr_fb_height();
-    int fb_height = gr_fb_width();
-#endif
+    if (touch_should_swap_xy()) {
+        fb_width = gr_fb_height();
+        fb_height = gr_fb_width();
+    }
 
     *x = (p->x - p->xi.minimum) * (fb_width - 1) / (p->xi.maximum - p->xi.minimum);
     *y = (p->y - p->yi.minimum) * (fb_height - 1) / (p->yi.maximum - p->yi.minimum);
@@ -734,17 +774,21 @@ static int vk_modify(struct ev *e, struct input_event *ev)
         return 1;
     }
 
-#ifdef RECOVERY_TOUCHSCREEN_SWAP_XY
-    x ^= y;
-    y ^= x;
-    x ^= y;
-#endif
-#ifdef RECOVERY_TOUCHSCREEN_FLIP_X
-    x = gr_fb_width() - x;
-#endif
-#ifdef RECOVERY_TOUCHSCREEN_FLIP_Y
-    y = gr_fb_height() - y;
-#endif
+    if (touch_should_swap_xy()) {
+        int tmp = x;
+        x = y;
+        y = tmp;
+    }
+    if (touch_should_flip_x()) {
+        x = gr_fb_width() - 1 - x;
+    }
+    if (touch_should_flip_y()) {
+        y = gr_fb_height() - 1 - y;
+    }
+    if (x < 0) x = 0;
+    if (x >= gr_fb_width()) x = gr_fb_width() - 1;
+    if (y < 0) y = 0;
+    if (y >= gr_fb_height()) y = gr_fb_height() - 1;
 
 #ifdef _EVENT_LOGGING
     printf("EV: x: %d  y: %d\n", x, y);
